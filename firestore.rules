rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolios collection
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blogs collection
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media collection
    match /media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
